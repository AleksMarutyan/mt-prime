generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  names        Json?    // ← Change from name to names
  descriptions Json?    // Store multiple language descriptions
  price        Float
  category     String?
  imagesUrls   Json?    // Store array of image URLs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}