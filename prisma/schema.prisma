generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES_URL")
}

model Product {
  id           String   @id @default(uuid())
  names        Json?    
  descriptions Json?    
  price        Float
  category     String?
  imagesUrls   Json?    
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}