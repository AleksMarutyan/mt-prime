# Environment Variables for MT PRIME Website

# Database
DATABASE_URL="file:./dev.db"

# API URL (for local development)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL for the application
# Local: http://localhost:3000
# Production: https://mtprime.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For local mobile testing on your network:
# NEXT_PUBLIC_APP_URL=http://192.168.10.49:3000

# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# Get this from: https://tagmanager.google.com/
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console Verification Code
# Get this from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code-here
